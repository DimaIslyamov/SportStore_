# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-generated-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Europe/Warsaw
DJANGO_HOST_PORT=8000

# PostgreSQL container
POSTGRES_DB=sportstore
POSTGRES_USER=sportstore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433

# Used when Django runs on the host computer
DATABASE_URL=postgresql://sportstore:change-me-local-only@127.0.0.1:5433/sportstore
