# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-generated-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Europe/Warsaw
DJANGO_HOST_PORT=8000

# JWT
JWT_SIGNING_KEY=replace-with-an-independent-generated-jwt-signing-key

# PostgreSQL container
POSTGRES_DB=sportstore
POSTGRES_USER=sportstore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433

# Used when Django runs on the host computer
DATABASE_URL=postgresql://sportstore:change-me-local-only@127.0.0.1:5433/sportstore

# S3 and AWS
CATALOG_S3_BUCKET=
CATALOG_S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_EC2_METADATA_DISABLED=true